<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/head') %>
        <title>Web Development</title>
        <script src="/js/class.js" defer></script>
</head>

<body class="bg-body-tertiary">

    <%- include('partials/navbar') %>

        <div class="container py-5" id="content">

            <h2 class="fw-bold" id="title"></h2>
            <p class="text-muted" id="info"></p>

            <hr class="my-4">

            <div class="card mb-4">
                <div class="card-header fw-semibold">Syllabus</div>
                <div class="card-body">
                    <p class="text-muted">Syllabus content goes here.</p>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header fw-semibold">Announcements</div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item"> Project 1 due Friday</li>
                        <li class="list-group-item"> Guest speaker next Tuesday</li>
