                    </ul>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header fw-semibold">Expectations</div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">Attend all classes</li>
                        <li class="list-group-item">Submit all work on time</li>
                        <li class="list-group-item">Participate actively in discussions</li>
                        <li class="list-group-item">Follow the academic integrity policy</li>
                    </ul>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header fw-semibold">Links</div>
            </div>

        </div>

</body>

